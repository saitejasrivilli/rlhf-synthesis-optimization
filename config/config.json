{
  "data": {
    "synthesis_trajectories": 100,
    "train_val_split": 0.8,
    "trajectory_length": 5
  },
  "reward_model": {
    "backbone": "bert-base-uncased",
    "hidden_dim": 768,
    "dropout": 0.1,
    "learning_rate": 1e-4
  },
  "policy": {
    "base_model": "meta-llama/Llama-2-7b-hf",
    "method": "lora",
    "lora_r": 8,
    "lora_alpha": 16,
    "max_seq_length": 512
  },
  "rlhf_training": {
    "ppo_epochs": 3,
    "batch_size": 4,
    "learning_rate": 1e-5,
    "clip_ratio": 0.2,
    "value_coef": 0.5,
    "entropy_coef": 0.01,
    "kl_div_weight": 0.1
  },
  "evaluation": {
    "test_trajectories": 20,
    "metrics": ["average_reward", "kl_divergence", "policy_improvement"]
  }
}
